{
  "name": "Push \u2014 Novo Evento de Agenda",
  "description": "Envia notifica\u00e7\u00e3o push no celular do respons\u00e1vel e participantes quando um novo evento \u00e9 criado na Agenda. Tocar na notifica\u00e7\u00e3o abre o evento.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ScheduleEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_novo_evento_agenda",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarNovoEventoAgenda",
            "args": {
              "event_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar push do novo evento",
            "description": "Notifica respons\u00e1vel e participantes"
          }
        }
      }
    ]
  }
}