{
  "name": "Motor de Lembretes Agenda IA",
  "description": "Dispara os lembretes pendentes da agenda uma vez por dia, \u00e0s 07:00 (hor\u00e1rio de Bras\u00edlia)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "motor_de_lembretes_agenda_ia",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runScheduleReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Disparar lembretes pendentes (07:00)",
            "description": "runScheduleReminders"
          }
        }
      }
    ]
  }
}