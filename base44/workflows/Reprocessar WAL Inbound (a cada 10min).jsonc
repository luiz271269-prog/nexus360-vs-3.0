{
  "description": "Consome o WebhookInboundWAL: reenvia webhooks pendentes (Z-API/W-API) para os endpoints com idempot\u00eancia por messageId. Rede de seguran\u00e7a contra mensagens perdidas por 429/timeout.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reprocessar_wal_inbound",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reprocessar_wal": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reprocessarWebhookWAL",
            "args": {
              "limit": 30
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reprocessar WAL pendente",
            "description": "Reenvia webhooks n\u00e3o processados"
          }
        }
      }
    ]
  },
  "name": "Reprocessar WAL Inbound (a cada 10min)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}