{
  "name": "Fotos de Perfil \u2014 Preenchimento Gradual",
  "description": "Rede de seguran\u00e7a: 1x por dia, \u00e0s 03:10 (fora do hor\u00e1rio de uso), salva permanentemente a foto de um lote pequeno de contatos INATIVOS que nunca passaram pelo webhook. Contatos ativos j\u00e1 s\u00e3o resolvidos sob demanda no recebimento da mensagem.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "10 3 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fotos_perfil_gradual",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "buscar_fotos_lote": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buscarFotosPerfilEmLote",
            "args": {
              "limite": 20
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Lote noturno de fotos",
            "description": "20 contatos inativos \u00e0s 03:10"
          }
        }
      }
    ]
  }
}