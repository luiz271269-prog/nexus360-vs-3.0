{
  "name": "Fotos de Perfil \u2014 Preenchimento Gradual",
  "description": "A cada hora, busca e salva permanentemente as fotos de perfil dos contatos que ainda n\u00e3o t\u00eam foto ou t\u00eam apenas URL tempor\u00e1ria do WhatsApp.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fotos_perfil_gradual",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "buscar_fotos_lote": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buscarFotosPerfilEmLote",
            "args": {
              "limite": 8
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Buscar fotos pendentes",
            "description": "Lote de 8 contatos por hora"
          }
        }
      }
    ]
  }
}