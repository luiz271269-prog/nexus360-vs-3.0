{
  "description": "Reparo noturno: roda de hora em hora entre 00:00 e 05:00 (fora do hor\u00e1rio de uso) e substitui as URLs mortas do WhatsApp (403) por imagens permanentes, em lotes de no m\u00e1ximo 2 contatos. Contatos ativos j\u00e1 s\u00e3o resolvidos sob demanda no recebimento da mensagem.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fotos_perfil_gradual",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "buscar_fotos_lote": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buscarFotosPerfilEmLote",
            "args": {
              "dryRun": false
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reparar fotos mortas",
            "description": "Modo autom\u00e1tico, m\u00e1x. 2 contatos por execu\u00e7\u00e3o"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0-5 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Fotos de Perfil \u2014 Preenchimento Gradual"
}