{
  "name": "ScheduleReminder",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "target_user_id": {
      "type": "string"
    },
    "offset_minutes": {
      "type": "number"
    },
    "send_at": {
      "type": "string",
      "format": "datetime"
    },
    "relative_rule": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "app",
        "push",
        "email",
        "whatsapp",
        "desktop",
        "whatsapp_internal",
        "whatsapp_external",
        "internal"
      ],
      "default": "app"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "viewed",
        "confirmed",
        "skipped",
        "failed"
      ],
      "default": "pending"
    },
    "send_dedupe_key": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "sent_at": {
      "type": "string",
      "format": "datetime"
    },
    "delivered_at": {
      "type": "string",
      "format": "datetime"
    },
    "viewed_at": {
      "type": "string",
      "format": "datetime"
    },
    "confirmed_at": {
      "type": "string",
      "format": "datetime"
    },
    "failed_at": {
      "type": "string",
      "format": "datetime"
    },
    "dead_lettered_at": {
      "type": "string",
      "format": "datetime"
    },
    "provider_message_id": {
      "type": "string"
    },
    "error_details": {
      "type": "string"
    }
  },
  "required": [
    "target_user_id",
    "send_at",
    "send_dedupe_key"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.target_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.target_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}