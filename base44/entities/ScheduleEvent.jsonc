{
  "name": "ScheduleEvent",
  "type": "object",
  "properties": {
    "created_by_type": {
      "type": "string",
      "enum": [
        "external_contact",
        "internal_user"
      ]
    },
    "organizer_id": {
      "type": "string"
    },
    "assigned_user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "solicitacao",
        "tarefa",
        "agendamento",
        "lembrete",
        "retorno"
      ],
      "default": "agendamento"
    },
    "etapa": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "datetime"
    },
    "end_at": {
      "type": "string",
      "format": "datetime"
    },
    "all_day": {
      "type": "boolean",
      "default": false
    },
    "timezone": {
      "type": "string",
      "default": "America/Sao_Paulo"
    },
    "location": {
      "type": "string"
    },
    "meeting_link": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "scheduled",
        "draft",
        "confirmed",
        "cancelled",
        "completed",
        "no_show"
      ],
      "default": "scheduled"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "compromisso",
        "reuniao",
        "ligacao",
        "visita",
        "bloco_trabalho",
        "lembrete",
        "tarefa",
        "cobranca",
        "follow_up"
      ],
      "default": "compromisso"
    },
    "participants_external": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "participants_internal": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_thread_id": {
      "type": "string"
    },
    "source_message_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "orcamento_id": {
      "type": "string"
    },
    "context_type": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "event_dedupe_key": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "auto_committed": {
      "type": "boolean",
      "default": false
    },
    "cancelled_at": {
      "type": "string",
      "format": "datetime"
    },
    "completed_at": {
      "type": "string",
      "format": "datetime"
    },
    "calendar_account_id": {
      "type": "string"
    },
    "external_provider": {
      "type": "string",
      "enum": [
        "google",
        "outlook"
      ]
    },
    "external_event_id": {
      "type": "string"
    },
    "external_etag": {
      "type": "string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "local",
        "pending",
        "synced",
        "conflict",
        "failed"
      ],
      "default": "local"
    },
    "last_change_origin": {
      "type": "string",
      "enum": [
        "nexus",
        "google",
        "outlook"
      ]
    },
    "internal_version": {
      "type": "number",
      "default": 1
    },
    "external_version": {
      "type": "string"
    },
    "sync_hash": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string",
      "format": "datetime"
    },
    "google_calendar_event_id": {
      "type": "string"
    },
    "synced_to_google_at": {
      "type": "string",
      "format": "datetime"
    },
    "outlook_calendar_event_id": {
      "type": "string"
    },
    "synced_to_outlook_at": {
      "type": "string",
      "format": "datetime"
    }
  },
  "required": [
    "created_by_type",
    "assigned_user_id",
    "title",
    "start_at"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "data.participants_internal": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "data.participants_internal": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}