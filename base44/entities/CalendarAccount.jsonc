{
  "name": "CalendarAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "google",
        "outlook"
      ]
    },
    "email": {
      "type": "string"
    },
    "calendar_external_id": {
      "type": "string"
    },
    "sync_token": {
      "type": "string"
    },
    "webhook_channel_id": {
      "type": "string"
    },
    "webhook_expires_at": {
      "type": "string",
      "format": "datetime"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "last_sync_at": {
      "type": "string",
      "format": "datetime"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "provider",
    "email"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}